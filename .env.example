# ==============================================================================
# Environment Configuration (.env.example)
# Bitrix-CRM (Simple CRM mode)
# Copy this file to .env before starting the application: cp .env.example .env
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password_change_in_production

# Backend (FastAPI)
PROJECT_NAME="Bitrix CRM"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_random_secret_key_for_jwt_tokens_here
ACCESS_TOKEN_EXPIRE_MINUTES=11520
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost"]
BACKEND_PORT=8000

# Reverse Proxy (Nginx)
HTTP_PORT=80

# Frontend (Next.js)
# Client-side accessible API Base URL (used in browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal Docker SSR API URL (used by Next.js server components if needed)
INTERNAL_API_URL=http://backend:8000
FRONTEND_PORT=3000

